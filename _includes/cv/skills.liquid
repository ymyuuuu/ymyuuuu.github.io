{% comment %}
  Unified skills entry renderer for both formats
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="skill-item">
      <div class="col-xs-12 col-sm-12 col-md-12">
        {% if entry.icon %}
          <i class="{{ entry.icon }}"></i>
        {% endif %}
        <strong>
          {{- entry.name -}}
          {%- if entry.level %} ({{ entry.level }}){% endif -%}
        </strong><br>
        {% if entry.keywords %}
          {{ entry.keywords | join: ', ' }}
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

<style>
  .skill-item {
    padding: 0.5rem 0;
  }
</style>